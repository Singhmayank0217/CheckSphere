# CheckSphere backend configuration. Copy to backend/.env and fill in. Never commit backend/.env.

# --- MongoDB Atlas (required) ---
# Atlas -> Database -> Connect -> Drivers. Keep the password out of chat, Git and screenshots.
# Local development: use the dev-only Atlas user (readWrite on checksphere_dev only) and the checksphere_dev database.
# Railway PRODUCTION sets its own variables: DB_NAME=checksphere with the separate production database user.
# Never point a local .env at checksphere, and never run seed, test or cleanup scripts against it.
MONGO_URL=mongodb+srv://<dev-user>:<password>@<cluster-host>/checksphere_dev?retryWrites=true&w=majority
DB_NAME=checksphere_dev

# --- Auth (required) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"   (different value per environment)
JWT_SECRET=
# Optional: access-token lifetime in hours (default 12)
# ACCESS_HOURS=12

# --- Cloudflare R2 media storage (required: the only file storage) ---
# Private bucket + an API token scoped to that bucket (Object Read & Write). Backend only: never in the frontend,
# EXPO_PUBLIC_* vars, chat or Git. Photos, PDFs, request documents and backups are all stored here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=checksphere-test
# Optional; derived from R2_ACCOUNT_ID when empty: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Lifetime of a signed direct-upload URL, seconds (default 600). DIRECT_UPLOAD_ENABLED=false forces API uploads.
# R2_UPLOAD_URL_TTL_SECONDS=600
# DIRECT_UPLOAD_ENABLED=true

# Optional: folder segment separating environments (checksphere/<env>/...). Default: dev
MEDIA_FOLDER_ENV=dev
# Optional: lifetime of server-side signed download URLs, seconds (default 60)
# DOWNLOAD_LINK_TTL_SECONDS=60

# --- Case reference location (address -> map coordinates) ---
# New cases without a pinned location are looked up in the background via OpenStreetMap Nominatim
# (only the address text, city, state and pincode are sent; max 1 request/second). Set to "off" to disable.
# GEOCODING_PROVIDER=nominatim
# Identify your deployment to Nominatim (their usage policy asks for an identifying User-Agent).
# GEOCODER_USER_AGENT=CheckSphere/1.0 (internal field verification system)

# --- Hosting (Railway) ---
# Railway sets PORT itself. Web dashboard origins for CORS (comma-separated); default *.
# ALLOWED_ORIGINS=https://dashboard.example.com
# In-memory caches; use 48 / 32 on Railway Free (about 0.5 GB RAM).
# IMAGE_CACHE_MB=200
# REPORT_CACHE_MB=150
# true only with Railway Serverless enabled: background jobs run on demand, MongoDB polls rarely.
# SERVERLESS_MODE=false

# --- Remote push notifications (agents' phones: new case assigned / case reassigned) ---
# Off unless set to true, so local development and tests never reach the real Expo push service.
# PUSH_ENABLED=false
# Only when "Enhanced security for push notifications" is turned on in the Expo account (secret; Railway only).
# EXPO_ACCESS_TOKEN=

# --- Optional ---
# COMPANY_NAME=CheckSphere
# Folder for the in-app "Run backup" JSON exports when R2 is NOT configured (default: backend/backups, git-ignored).
# With R2 configured, backups go to the private bucket (checksphere/<env>/backups/).
# BACKUP_DIR=
# ONLY for a throwaway local development database: creates demo users with known passwords.
# Never set this to true against a real database.
# SEED_DEMO_DATA=false
