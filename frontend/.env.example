# CheckSphere app configuration. Copy to frontend/.env. Values here are PUBLIC (bundled into the app/APK) —
# never put secrets in EXPO_PUBLIC_* variables. Restart `npm start` after changing.
#
# Web on this PC:              http://localhost:8001
# Android emulator:            http://10.0.2.2:8001
# Physical phone on same Wi-Fi: http://<this PC's LAN IP>:8001   (start backend with --host 0.0.0.0)
# Production APK / web:        https://api.<your-domain>
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# Map preview tiles (optional). Use a licensed tile provider and its public, domain/app-restricted key, e.g. MapTiler,
# Stadia Maps or Thunderforest. Leave empty to show coordinates + "Open in Google Maps" instead of a map image.
# Do NOT use tile.openstreetmap.org: its usage policy forbids distributed apps (it returns "403 Access blocked" tiles).
# EXPO_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_PUBLIC_KEY
# EXPO_PUBLIC_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
